{
  "name": "taman-bunga",
  "version": "1.1.0",
  "private": true,
  "description": "Taman bunga malam interaktif — HTML, SCSS/CSS, dan parallax JS minimal.",
  "license": "MIT",
  "author": "fadhilfaith48",
  "repository": {
    "type": "git",
    "url": "https://github.com/fadhilfaith48/Taman-Bunga.git"
  },
  "scripts": {
    "build": "sass scss/style.scss css/style.css --no-source-map",
    "watch": "sass --watch scss/style.scss css/style.css --no-source-map",
    "check": "node scripts/check-css.js",
    "lint:html": "html-validate index.html flower.html 404.html",
    "test": "node tests/qa.js && node tests/parallax.js"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "devDependencies": {
    "html-validate": "^11.21.0",
    "playwright-core": "^1.65.0",
    "sass": "^1.107.1"
  }
}
